NODE_ENV=development
REALMOS_ENV=local
REALMOS_INSTANCE_NAME="Idan Jarvis HQ"

API_PORT=4100
WEB_PORT=3000

DATABASE_URL=postgres://realmos:realmos@localhost:5432/realmos
REDIS_URL=redis://localhost:6379

OLLAMA_BASE_URL=http://localhost:11434
# Preferred local Jarvis model (machine-level; pull with: ollama pull llama3.2:3b)
OLLAMA_DEFAULT_MODEL=llama3.2:3b
# Legacy alias — OLLAMA_DEFAULT_MODEL takes precedence when both are set
REALMOS_LOCAL_MODEL=llama3.2:3b
# Set REALMOS_OLLAMA_ENABLED=false to skip live probes and always use stub fallback
# REALMOS_OLLAMA_ENABLED=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

REALMOS_MONTHLY_BUDGET_USD=50
REALMOS_REQUIRE_APPROVAL_ABOVE_USD=1
REALMOS_ALLOW_ONLINE_MODELS=false

# Real shell execution for approved terminal tool runs only (default: off)
REALMOS_ALLOW_TERMINAL=false
# Alias accepted by tool-runner (prefer REALMOS_ALLOW_TERMINAL)
REALMOS_TERMINAL_ENABLED=false
REALMOS_ALLOW_FILESYSTEM_WRITE=true
REALMOS_ALLOW_BROWSER_AUTOMATION=false
REALMOS_ALLOW_GITHUB=false
REALMOS_ALLOW_EMAIL=false
REALMOS_ALLOW_CAMERA=false
REALMOS_ALLOW_MICROPHONE=false

REALMOS_ARTIFACTS_DIR=./generated/artifacts
REALMOS_BUSINESSES_DIR=./generated/businesses
REALMOS_RUNS_DIR=./generated/runs

REALMOS_ENABLE_MOCK_DATA=true
REALMOS_ENABLE_WORLD_VIEW=true
REALMOS_ENABLE_SPECKIT_GENERATION=true

# API (Phase 3)
API_BASE_URL=http://localhost:4100
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100
# Use in-memory API storage when Postgres is not running locally
REALMOS_USE_MEMORY_DB=true

# Optional: live Postgres smoke (pnpm test:postgres) — requires running Postgres
# DATABASE_URL=postgres://realmos:realmos@localhost:5432/realmos

# Firebase baseline (optional — not required for local MVP verification)
# Server/API project id — set when you have a Firebase project selected
# FIREBASE_PROJECT_ID=
# Emulator hosts (local Firebase Emulator Suite — install Firebase CLI separately)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Set REALMOS_FIREBASE_ENABLED=false to force disabled status in health checks
# REALMOS_FIREBASE_ENABLED=true

# Web client public Firebase config (safe to expose in browser — never put private keys here)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
